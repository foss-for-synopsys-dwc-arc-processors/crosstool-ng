CT_CONFIG_VERSION="4"
CT_PREFIX_DIR="${CT_TOP_DIR}/riscv64-snps-elf-picolibc"
# CT_PREFIX_DIR_RO is not set
CT_ARCH_RISCV=y
CT_MULTILIB=y
CT_ARCH_64=y
CT_ARCH_ARCH="rv64gc"
CT_ARCH_ABI="lp64d"
CT_TARGET_CFLAGS="-g -O3 -ftls-model=local-exec"
CT_TARGET_VENDOR="snps"
CT_TARGET_ALIAS_SED_EXPR="s/snps/unknown/"
CT_TARGET_ALIAS="riscv64-elf"
CT_BINUTILS_SRC_DEVEL=y
CT_BINUTILS_DEVEL_URL="https://github.com/foss-for-synopsys-dwc-arc-processors/binutils-gdb"
CT_BINUTILS_DEVEL_BRANCH="arc-2025.06"
CT_LIBC_PICOLIBC=y
CT_PICOLIBC_SRC_DEVEL=y
CT_PICOLIBC_DEVEL_URL="https://github.com/foss-for-synopsys-dwc-arc-processors/picolibc"
CT_PICOLIBC_DEVEL_BRANCH="arc-2025.06"
CT_LIBC_PICOLIBC_IO_LL=y
CT_LIBC_PICOLIBC_EXTRA_SECTIONS=y
CT_LIBC_PICOLIBC_OBSOLETE_FLOAT=y
CT_LIBC_PICOLIBC_EXTRA_CONFIG_ARRAY="-Doptimization=3 -Dio-long-double=true -Dio-percent-b=true -Dprintf-percent-n=true -Dfast-bufio=true -Dmb-capable=true -Dio-wchar=true -Dposix-console=true -Dnewlib-obsolete-math=false -Dwant-math-errno=true -Dassert-verbose=true"
CT_LIBC_PICOLIBC_DEFAULT_FLASH_ADDR="0x00000000"
CT_LIBC_PICOLIBC_DEFAULT_FLASH_SIZE="128K"
CT_LIBC_PICOLIBC_DEFAULT_RAM_ADDR="0x40020000"
CT_LIBC_PICOLIBC_DEFAULT_RAM_SIZE="128K"
CT_GCC_SRC_DEVEL=y
CT_GCC_DEVEL_URL="https://github.com/foss-for-synopsys-dwc-arc-processors/gcc"
CT_GCC_DEVEL_BRANCH="arc-2025.06"
CT_CC_GCC_CONFIG_TLS=y
CT_CC_LANG_CXX=y
CT_DEBUG_GDB=y
CT_GDB_SRC_DEVEL=y
CT_GDB_DEVEL_URL="https://github.com/foss-for-synopsys-dwc-arc-processors/binutils-gdb"
CT_GDB_DEVEL_BRANCH="arc-2025.06-gdb"
CT_GDB_V_15=y
# CT_GDB_CROSS_PYTHON is not set
CT_COMP_LIBS_PICOLIBC_NANO=y
CT_PICOLIBC_NANO_SRC_DEVEL=y
CT_PICOLIBC_NANO_DEVEL_URL="https://github.com/foss-for-synopsys-dwc-arc-processors/picolibc"
CT_PICOLIBC_NANO_DEVEL_BRANCH="arc-2025.06"
CT_LIBC_PICOLIBC_NANO_IO_C99FMT=y
CT_LIBC_PICOLIBC_NANO_EXTRA_SECTIONS=y
CT_LIBC_PICOLIBC_NANO_OBSOLETE_FLOAT=y
CT_LIBC_PICOLIBC_NANO_EXTRA_CONFIG_ARRAY="-Doptimization=s -Dposix-console=true -Dnewlib-obsolete-math=false -Dwant-math-errno=true -Dassert-verbose=true"
CT_LIBC_PICOLIBC_NANO_GCC_LIBSTDCXX_TARGET_CXXFLAGS="-fno-exceptions -msave-restore -g"
